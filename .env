# Dev-time overrides for this checkout. `jukebox run` otherwise defaults to a per-user config
# location (~/.config/jukebox/, see packages/cli/src/jukebox_cli/run.py) -- for developing in
# this repo we want the familiar repo-local shared/settings/ instead. Loaded automatically by
# `jukebox_cli.cli` via python-dotenv.
JUKEBOX_CONF=shared/settings/jukebox.yaml
JUKEBOX_LOGGER_CONF=shared/settings/logger.yaml
