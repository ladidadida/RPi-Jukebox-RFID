  "name": "system",
  "operations": {
    "get_app_settings": {
      "args": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "query",
      "method": "GET",
      "path": "/api/v1/settings",
      "returns": {
        "properties": {
          "show_covers": {
            "default": true,
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "get_info": {
      "args": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "query",
      "method": "GET",
      "path": "/api/v1/system/info",
      "returns": {
        "properties": {
          "git_state": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "git_state",
          "started_at"
        ],
        "type": "object"
      }
    },
    "get_log": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "debug",
            "enum": [
              "debug",
              "error"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "query",
      "method": "GET",
      "path": "/api/v1/system/log",
      "returns": {
        "type": "string"
      }
    },
    "noop": {
      "args": {
